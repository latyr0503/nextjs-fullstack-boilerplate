# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL (utilisé par Redux Toolkit RTK Query)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Email de réception des contacts
NEXT_PUBLIC_EMAIL="contact@example.com"

# Neon Serverless PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Resend API Key (pour l'envoi d'emails transactionnels)
NEXT_RESEND_API_KEY="re_your_resend_api_key"

# Telegram Bot (optionnel : notifications directes de contact)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# PostHog Analytics (optionnel)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_your_posthog_token"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
